# ---- Supabase (public, safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Supabase server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
# Used by server routes for admin/matching/payment operations. RLS is still enforced
# for every end-user request; the service role is only used after explicit server-side
# authorisation checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ---- Razorpay (optional — payments stay disabled until both are set) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Google OAuth (optional — configure in Supabase dashboard) ----
# Set up under Supabase → Authentication → Providers → Google.
